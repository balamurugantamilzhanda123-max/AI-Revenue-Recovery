# ReviveAI Environment Configuration Template

# Application
ENVIRONMENT=production
APP_NAME=ReviveAI API
APP_VERSION=1.0.0

# Database (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./reviveai_demo.db
AUTO_CREATE_TABLES=true

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://reviveai.vercel.app

# AI Agent Configuration
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4.1-mini
AI_MOCK_MODE=false

# Supabase (Optional - if using Supabase DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payment Gateway & Recovery Policy Rules
PAYMENT_SANDBOX_MODE=true
MAX_AUTOMATIC_RETRIES=1
MAX_RECOVERY_MESSAGES=2
LOW_CONFIDENCE_THRESHOLD=0.70
