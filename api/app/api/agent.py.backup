router = APIRouter(
    prefix="/agent",
    tags=["AI Agent"],
)
@router.post("/decide/{transaction_id}")
def decide_recovery_endpoint(transaction_id: str):
    return {
        "transaction_id": transaction_id,
        "decision": "controlled_retry",
        "policy": "APPROVED",
        "allowed": True,
    }

