# ReviveAI Backend Environment Configuration Template

ENVIRONMENT=production
APP_NAME=ReviveAI API
APP_VERSION=1.0.0

# Database Connection (PostgreSQL for production, SQLite for local demo)
DATABASE_URL=sqlite:///./reviveai_demo.db
AUTO_CREATE_TABLES=true

# CORS Configuration (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://reviveai.vercel.app

# AI Engine Credentials
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4.1-mini
AI_MOCK_MODE=false

# Supabase Storage & Telemetry (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Safety & Autonomous Policy Limits
PAYMENT_SANDBOX_MODE=true
MAX_AUTOMATIC_RETRIES=1
MAX_RECOVERY_MESSAGES=2
LOW_CONFIDENCE_THRESHOLD=0.70
AUTH_ENABLED=false
API_AUTH_TOKEN=your-production-secret-token
